# SupermarketBilling — environment template. Contains NO secrets.
# Create your real .env with:  powershell -NoProfile -ExecutionPolicy Bypass -File scripts\setup-dev.ps1
# setup-dev.ps1 copies this file and replaces every CHANGE_ME value with a random password.
# .env is git-ignored. Never commit it and never paste it into tickets or chat.

# ---- Operational database (PostgreSQL 16, Docker) ----
SB_DB_HOST=localhost
SB_DB_PORT=5442
SB_DB_NAME=supermarketbilling
SB_DB_SUPERUSER=sb_admin
SB_DB_SUPERUSER_PASSWORD=CHANGE_ME
SB_DB_MIGRATOR_USER=sb_migrator
SB_DB_MIGRATOR_PASSWORD=CHANGE_ME
SB_DB_APP_USER=sb_app
SB_DB_APP_PASSWORD=CHANGE_ME

# Connection strings used by the API and migration tooling (setup-dev.ps1 fills the passwords).
ConnectionStrings__Main=Host=localhost;Port=5442;Database=supermarketbilling;Username=sb_app;Password=CHANGE_ME
ConnectionStrings__Migrator=Host=localhost;Port=5442;Database=supermarketbilling;Username=sb_migrator;Password=CHANGE_ME
# Integration tests use a separate database so they never touch development data.
ConnectionStrings__Test=Host=localhost;Port=5442;Database=supermarketbilling_test;Username=sb_app;Password=CHANGE_ME
ConnectionStrings__TestMigrator=Host=localhost;Port=5442;Database=supermarketbilling_test;Username=sb_migrator;Password=CHANGE_ME

# ---- Security ----
# Encrypts MFA secrets stored in the database. Keep a copy OFFLINE with the backup passphrase: restoring the
# database on a new server needs this key, or users will have to set up MFA again.
Security__DataProtectionKey=CHANGE_ME

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
API_INTERNAL_URL=http://localhost:5080

# ---- Web applications (fixed dev ports: billing 3000, owner 3001, collection 3002, archive 3003) ----
NEXT_TELEMETRY_DISABLED=1

# ---- Backups ----
# Encrypts every backup. Store a copy OFFLINE (for example printed, in a safe); without it backups cannot be restored.
SB_BACKUP_PASSPHRASE=CHANGE_ME
SB_BACKUP_DIR=backups
SB_DB_CONTAINER=supermarketbilling-db

# ---- Optional Owner Archive Web (licensed feature; disabled by default) ----
ARCHIVE_WEB_ENABLED=false
SB_ARCHIVE_DB_NAME=supermarketbilling_archive
SB_ARCHIVE_DB_PORT=5443
